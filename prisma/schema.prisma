// Prisma schema — Student Application Profile Evaluator
//
// Runs on PostgreSQL in both development and production. Using the same engine
// in both places avoids the class of bug where something works locally and then
// fails in production.
//
// The "enum" fields below are plain `String` columns, and structured AI output
// is a serialized JSON `String`. Their allowed values and shape are defined
// once, authoritatively, in lib/validation (Zod), which every write is checked
// against. Converting them to native Postgres `enum` / `jsonb` columns is
// possible but deliberately not done — Zod is already the enforcement point,
// and plain columns keep migrations simple.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth / account
// ---------------------------------------------------------------------------

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String?
  // The account's DEFAULT home country, set at signup. Each student profile
  // carries its own, since a counselor's students do not share one and the
  // domestic-vs-international distinction is material to an evaluation. This
  // is what a new student inherits.
  countryOfOrigin String? // ISO code
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Brute-force protection. Stored on the user rather than in memory so the
  // limit actually holds across serverless instances and restarts.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // MANY profiles per user, one per student.
  //
  // A counselor or tutoring agency runs several students from one account, so
  // an account holds a list of student profiles rather than being a student.
  // Students do not log in; the account owns their records outright, which is
  // what keeps the privacy rule intact — every query still filters by ONE
  // authenticated user id, and no sharing or cross-account access exists to
  // get wrong. A solo student is just an account with one profile.
  profiles Profile[]

  // Which student the account is currently working on. Nullable, and never
  // trusted on its own: resolving it checks the profile still belongs to this
  // user, so a stale or tampered value falls back rather than leaking.
  activeProfileId String?

  // The counselor edition. Absent on an ordinary account, which is what makes
  // the two products separate rather than one with a mode flag.
  counselorAccount CounselorAccount?

  // Links where THIS account is the student side — the grants it has given and
  // can revoke. Named, because the counselor side of a link points at a
  // CounselorAccount rather than at a User.
  caseloadGrants CaseloadLink[] @relation("CaseloadStudentUser")

  /// The test-prep edition, where THIS account is the student being tutored.
  /// Named for the same reason as caseloadGrants: the tutor side of all of this
  /// hangs off a CounselorAccount, not off a User.
  scoreAttempts     ScoreAttempt[]     @relation("TestPrepStudent")
  scoreTargets      ScoreTarget[]      @relation("TestPrepStudent")
  stoppingSignals   StoppingSignal[]   @relation("TestPrepStudent")
  progressArtifacts ProgressArtifact[] @relation("TestPrepStudent")

  passwordResetTokens PasswordResetToken[]

  /// The Stripe Customer this account maps to, created on first checkout.
  ///
  /// Null for everybody who has never opened checkout, which is most accounts
  /// and is not an error state. Stored so a returning customer reuses their
  /// customer record rather than accumulating a new one per checkout, which is
  /// what makes the billing portal and invoice history coherent.
  stripeCustomerId String? @unique

  subscriptions Subscription[]

  /// Test-access codes this account has redeemed, and the runs they bought.
  codeRedemptions AccessCodeRedemption[]
  runCredits      RunCredit[]
}

/// A paid plan an account holds, mirrored from Stripe.
///
/// STRIPE IS THE SOURCE OF TRUTH, and this table is a local cache of it. That
/// direction matters: the money moved in Stripe whatever this row says, so a
/// disagreement is always resolved by believing Stripe and correcting this —
/// never the other way round. Nothing in this app charges a card; Stripe does,
/// and the webhook copies the result here so a page render does not need a
/// network call to know what someone is on.
///
/// One row per Stripe subscription rather than one per account, so a lapsed
/// subscription stays readable next to its replacement instead of being
/// overwritten. Which one is in force is decided by status, not by recency.
model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A plan code from lib/billing/plans.ts. Stored as text on purpose: a plan
  /// that is retired from the catalogue must not orphan the row recording that
  /// somebody paid for it.
  planCode String

  stripeSubscriptionId String  @unique
  stripeCustomerId     String
  /// The Stripe Price this subscription bills against, kept for support: it is
  /// the field that answers "what were they actually charged" a year later.
  stripePriceId        String?

  /// Stripe's own status string — active, trialing, past_due, canceled, unpaid,
  /// incomplete, incomplete_expired, paused. NOT narrowed to a boolean here,
  /// because past_due and canceled call for different words to the customer and
  /// collapsing them would lose the distinction at the point it matters most.
  status String

  /// When the paid-for period ends. An access decision reads this rather than
  /// assuming a canceled subscription ends immediately — somebody who cancels
  /// on the 2nd keeps what they paid for until the 30th.
  currentPeriodEnd DateTime?
  /// Set when the customer has cancelled but the period has not run out yet.
  cancelAtPeriodEnd Boolean @default(false)

  /// The `created` timestamp of the most recent Stripe event applied to this
  /// row. Webhook deliveries are not ordered, so an older event arriving late
  /// must not overwrite newer state — this is what that check compares against.
  lastEventAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

/// A code that grants one run of something, for handing out during testing.
///
/// Deliberately NOT a discount code and not a Stripe coupon: it grants a single
/// RUN, not a price change, so it never touches billing and cannot be worth
/// money. The worst case if one leaks is that a stranger gets one free Deep
/// Review, which is bounded by maxRedemptions and by the account spend cap
/// underneath it.
model AccessCode {
  id String @id @default(cuid())

  /// Uppercase, unambiguous characters only — these get read down a phone and
  /// typed by hand. See lib/billing/codes.ts for the alphabet and why.
  code String @unique

  /// A RunKind: DEEP_REVIEW | PROJECTION | CHECK_IN.
  grantsKind String
  /// How many runs one redemption is worth. Almost always 1.
  grantsCount Int @default(1)

  /// How many DIFFERENT accounts may redeem this. A code handed to one tester
  /// is 1; a code read out to a room is however many people are in it.
  maxRedemptions Int @default(1)
  redemptionCount Int @default(0)

  expiresAt DateTime?
  /// Why this code exists, for whoever finds it in the table in six months.
  note      String?

  createdAt   DateTime            @default(now())
  redemptions AccessCodeRedemption[]

  @@index([code])
}

/// One account's use of one code.
///
/// The unique constraint is the enforcement: it makes redeeming twice a
/// database error rather than something the application has to remember to
/// check, so one person cannot drain a code meant for a group.
model AccessCodeRedemption {
  id           String     @id @default(cuid())
  accessCodeId String
  accessCode   AccessCode @relation(fields: [accessCodeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  redeemedAt DateTime @default(now())

  @@unique([accessCodeId, userId])
  @@index([userId])
}

/// Runs an account may make regardless of its plan's quota.
///
/// One row per account per kind, holding a remaining count. Spent ONLY when the
/// quota would otherwise refuse — see checkQuota — so a credit is never burned
/// on a run somebody was entitled to anyway.
model RunCredit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A RunKind, matching AccessCode.grantsKind.
  kind      String
  remaining Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kind])
}

/// Every Stripe event this app has already applied, so it applies it once.
///
/// Stripe retries deliveries and explicitly does not promise exactly-once, so
/// a handler without this table will eventually double-apply something. The
/// row is written in the SAME transaction as the effect, which is what makes
/// the pair atomic: a crash between the two would otherwise either lose the
/// effect or record it as done without doing it.
model StripeEvent {
  /// Stripe's own event id (evt_...), which is the deduplication key.
  id          String   @id
  type        String
  /// Stripe's created time, used to reject events older than applied state.
  stripeCreatedAt DateTime
  receivedAt  DateTime @default(now())

  @@index([type])
}

/// A single-use, expiring permission to set a new password.
///
/// The token itself is NEVER stored — only its SHA-256. A reset token is a
/// bearer credential for an account holding a minor's personal data, so a
/// database leak must not hand over working ones. Verification hashes the
/// incoming token and looks the hash up, which is also why no timing-safe
/// comparison is needed: the lookup key is a hash of a 256-bit random value.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  /// Set the moment it is redeemed. Presence here means "spent", which is what
  /// makes the token single-use rather than reusable until it expires.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// The student's application profile
// ---------------------------------------------------------------------------

model Profile {
  id              String  @id @default(cuid())
  // NOT unique: one account holds many students. Every ownership check in
  // lib/ownership still routes through this column, so widening it changed
  // who can hold a profile without changing who can read one.
  userId          String
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // What the account calls this student. Null on the profile a solo student
  // made before this existed, where "your profile" is the honest label.
  studentName     String?
  // This student's home country, overriding the account default. Affects
  // domestic vs international status, which changes the assessment.
  countryOfOrigin String? // ISO code
  gradeLevel      String? // e.g. "Grade 11", "Year 12"
  // School context. Not all schools are equally rigorous, and a GPA means very
  // little without knowing what was available to earn it — which courses the
  // school offers, how it grades, whether it ranks.
  schoolName      String?
  // The RESOLVED school, once the free text above has been matched to a row in
  // School. Nullable and kept alongside schoolName rather than replacing it:
  // the typed name is what the student wrote and what the evaluation reads, and
  // an unmatched school must degrade to "no discovery cohort" rather than
  // silently attaching the student to the wrong one.
  schoolId        String?
  school          School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  // Expected year of leaving school. Discovery groups by year to compare like
  // with like; gradeLevel alone cannot do that, since "Grade 11" means a
  // different cohort each September.
  graduationYear  Int?
  schoolContext   String?
  curriculum      String? // Zod enum: pre_ib | ib | ap | a_levels | gcse | other
  gpa             Float?
  gpaScale        String? // "4.0", "45" (IB), "letter", ...
  intendedMajor   String?
  /// intendedMajor normalized to the shared subject taxonomy, so "students
  /// aiming at a similar subject" can be a query rather than a string match.
  /// Zod enum, see lib/discovery/majors.ts. Null when the free text does not
  /// map, which keeps that student out of every subject cohort rather than
  /// putting them into the wrong one.
  majorCategory   String?
  careerGoal      String?

  /// A short-lived, single-use code the STUDENT generates and hands to a
  /// counselor, who redeems it to open a caseload link.
  ///
  /// The invitation runs in this direction on purpose. The obvious design —
  /// the counselor types a student's email address — turns this app into an
  /// oracle for whether a given address belongs to a minor's account, and it
  /// cannot say WHICH student when one account holds several siblings. A code
  /// the student issues answers both: nothing is disclosed to an address that
  /// never asked, and the student has already named the profile by choosing
  /// where to generate it.
  ///
  /// Redeeming it counts as the student's own consent, because generating and
  /// handing it over IS that act. A guardian still has to agree separately
  /// before anything is readable.
  counselorInviteCode      String?   @unique
  counselorInviteExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumeItems      ResumeItem[]
  testScores       TestScore[]
  targetSchools    TargetSchool[]
  evaluations      Evaluation[]
  plannedItems     PlannedItem[]
  projections      Projection[]
  commitments      Commitment[]
  digests          ProfileDigest[]
  /// Counselor access GRANTED on this student. Read-only by construction — a
  /// link carries no write path to any field on this model.
  caseloadLinks    CaseloadLink[]
  developments     Development[]
  discoveryConsent DiscoveryConsent?

  @@index([userId])
  @@index([schoolId])
  /// The discovery cohort query: students at one school, aiming at a similar
  /// subject, leaving in a given year.
  @@index([schoolId, majorCategory, graduationYear])
}

/// Something the student INTENDS to do but has not done.
///
/// Deliberately a separate table from ResumeItem rather than a flag on it.
/// Intentions must never leak into an evaluation or the progress chart: the
/// history view is a record of what has actually been achieved, and letting
/// plans inflate it would make the one number the student tracks untrustworthy.
model PlannedItem {
  id           String    @id @default(cuid())
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  // Same Zod enum as ResumeItem.type.
  type         String
  title        String
  description  String?
  org          String?
  /// When they intend to start, or the deadline they are working toward.
  targetDate   DateTime?
  hoursPerWeek Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([profileId])
}

/// A conditional "what if I did these things" projection.
///
/// Stored apart from Evaluation for the same reason PlannedItem is stored apart
/// from ResumeItem — a projection is a hypothetical, and no query that builds
/// the student's real history should have to remember to filter it out.
model Projection {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Zod enum: pending | completed | failed
  status String @default("pending")

  model         String? // projections run on a cheaper model than evaluations
  promptVersion String?
  isSample      Boolean @default(false)

  /// The real evaluation this projects forward from, if there was one. Kept as
  /// a plain id (not a relation) so deleting an old evaluation cannot cascade
  /// away a projection the student is still reading.
  baseEvaluationId String?

  inputSnapshotJson String?
  resultJson        String?
  error             String?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  // What this run cost, same columns and same reason as Evaluation. A
  // projection is a real API call on the account's credits, so leaving it
  // unrecorded would make the per-account spending cap undercount — and a cap
  // that quietly misses a whole category of spend is worse than none.
  inputTokens       Int?
  outputTokens      Int?
  cacheWriteTokens  Int?
  cacheReadTokens   Int?

  @@index([profileId])
}

model ResumeItem {
  id            String    @id @default(cuid())
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  // Zod enum: coursework | extracurricular | leadership | award | research |
  //           work | volunteering | project | certification
  type          String
  title         String
  description   String?
  org           String?
  startDate     DateTime?
  endDate       DateTime?
  hoursPerWeek  Float?
  evidenceNotes String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // --- Activity Discovery -------------------------------------------------
  // Discovery aggregates the resume items students ALREADY keep, rather than
  // asking them to maintain a second parallel list. So the normalization and
  // rung fields hang off this row.
  //
  // All nullable, all optional in the UI. A student who never opts in and
  // never fills these in is unaffected, and an aggregate simply counts only
  // what it actually has.

  /// Which entry in the shared taxonomy this maps to, once normalized.
  /// Null means unmapped: either not yet processed, or sent to review. An
  /// unmapped item is NEVER aggregated — the whole k-anonymity guarantee rests
  /// on counting shared categories, and free text is not shared.
  canonicalActivityId String?
  canonicalActivity   CanonicalActivity? @relation(fields: [canonicalActivityId], references: [id], onDelete: SetNull)
  /// How far the student actually got. Zod enum: participant | contributor |
  /// officer | initiator | regional | national.
  rungLevel           String?
  /// School years the activity spanned, e.g. 9 and 11. Kept separately from
  /// startDate/endDate because the useful answer is "students here start this
  /// in Grade 10", which a calendar date cannot give without knowing the year
  /// group at the time.
  startGrade          Int?
  endGrade            Int?

  @@index([profileId])
  @@index([canonicalActivityId])
}

// ---------------------------------------------------------------------------
// Activity Discovery
//
// Shows a student what extracurriculars others at their school, aiming at a
// similar subject, have actually done — as anonymized aggregates, never as a
// leaderboard. The disclosure rules live in lib/discovery/policy.ts; these are
// the tables they read.
// ---------------------------------------------------------------------------

/// A school, shared across profiles.
///
/// Exists so "students at my school" can mean something. Profile.schoolName
/// stays as the free text the student typed; this is the resolved entity, and
/// resolution is deliberately a separate step that can fail safely.
///
/// Not US-shaped: this app runs US, UK and EU rubrics, so the location fields
/// are country-first and ncesId is one optional external identifier among
/// whatever others get added, rather than the primary key of the world.
model School {
  id      String  @id @default(cuid())
  name    String
  /// ISO country code. Required — a school name alone is not unique globally.
  country String
  /// State, province, county or equivalent. Naming varies by country.
  region  String?
  city    String?
  /// US National Center for Education Statistics id, where one exists.
  ncesId  String? @unique

  /// Used by the "schools like yours" rung of the widening ladder. Kept coarse
  /// on purpose: fine-grained attributes would let a caller narrow a cohort
  /// until it resolved to one person.
  /// Zod enum: state | private | independent | international | selective | other
  schoolType String?
  /// Zod enum: small | medium | large. Bands, not counts.
  sizeBand   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles Profile[]

  /// What this school does with each test, per admissions cycle.
  testPolicies      SchoolTestPolicy[]
  /// Targets this school happens to set. Nullable on the other side, so a
  /// school that stops being the binding one does not take the target with it.
  bindsScoreTargets ScoreTarget[]

  /// One row per school per country — the same name recurs across countries.
  @@unique([name, country, region])
  @@index([country, region])
}

/// The shared activity taxonomy.
///
/// Aggregation counts students per canonical activity, so this list is the
/// vocabulary the whole feature speaks. It is curated and append-only by
/// humans: see the note on isApproved.
model CanonicalActivity {
  id          String @id @default(cuid())
  slug        String @unique
  displayName String
  /// Zod enum: research | clinical | service | leadership | competition |
  /// arts | athletics | work | independent
  category    String
  description String

  /// Activities that name a single person — a named fellowship, a national
  /// team place, a one-winner award. These need double the usual support
  /// before they are shown, because five students "doing research" is a
  /// category while five holding the same named fellowship is a list of names.
  isHighlyIdentifying Boolean @default(false)

  /// Only approved entries are ever aggregated or offered to the classifier.
  ///
  /// This is the guard against the worst failure mode in the pipeline: if a
  /// single student's free text could become a canonical activity, that
  /// activity IS that student's entry verbatim and every k-anonymity promise
  /// collapses. The model may only classify INTO this list; adding to it is a
  /// human action.
  isApproved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumeItems ResumeItem[]

  @@index([category])
}

/// Memoized normalization, so the same free text is classified once.
///
/// Keyed by a hash of the normalized text and NEVER by anything identifying:
/// this table is deliberately not joinable back to a student. Two students who
/// write "Science Olympiad" share one row, which is the point.
model NormalizationCache {
  id                  String   @id @default(cuid())
  rawTextHash         String   @unique
  canonicalActivityId String?
  /// 0..1. Results below the floor are routed to review rather than trusted.
  confidence          Float
  /// Which prompt/model produced this, so a taxonomy or prompt change can
  /// invalidate past classifications rather than inheriting them silently.
  modelVersion        String
  createdAt           DateTime @default(now())
}

/// Opt-in to contribute this student's activities to aggregates.
///
/// Per STUDENT, not per account. A counselor running twelve students is making
/// twelve separate decisions about twelve children's records, and revoking for
/// one must not revoke for the others.
///
/// Default is off by absence: no row means no consent. Viewing discovery is
/// NOT gated on this — gating would make consent the price of access, which is
/// not meaningful consent, least of all from a minor.
model DiscoveryConsent {
  id        String    @id @default(cuid())
  profileId String    @unique
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  grantedAt DateTime  @default(now())
  /// Set on revocation rather than deleting the row, so the decision has a
  /// history. Aggregates read `revokedAt: null`, so revocation takes effect on
  /// the next query with no backfill needed.
  revokedAt DateTime?

  @@index([revokedAt])
}

model TestScore {
  id        String    @id @default(cuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  // Zod enum: sat | act | ap | ib_subject | ib_total | predicted_grade |
  //           ucat | gcse | ielts | toefl | other
  kind      String
  label     String // "AP Biology", "Mathematics HL", "SAT Total"
  score     String // string on purpose so "1500", "7", and "A*" all fit one column
  maxScore  String?
  predicted Boolean   @default(false) // subject-level predicted grades are first-class (UK depth)
  takenOn   DateTime?
  createdAt DateTime  @default(now())

  @@index([profileId])
}

// ---------------------------------------------------------------------------
// Targets — where the student is applying
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// AI evaluations — immutable, timestamped snapshots
// ---------------------------------------------------------------------------

model Evaluation {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Zod enum: pending | completed | failed
  status String @default("pending")

  /// Zod enum: CHECK_IN | DEEP_REVIEW.
  ///
  /// A String rather than a Prisma enum to match every other constrained value
  /// in this schema — the app validates with Zod at the boundary, and a String
  /// means adding a tier later is a code change rather than a migration that
  /// locks the table.
  ///
  /// Defaults to DEEP_REVIEW because that is what every evaluation written
  /// before tiers existed actually was: a full-profile analysis on the strong
  /// model. Backfilling them as check-ins would misdescribe history.
  type String @default("DEEP_REVIEW")

  /// The rubric this was scored under, and the researched-data snapshot it
  /// read. Pinned, never recomputed: when the rubric changes, history keeps
  /// the numbers it was actually given, and the change is drawn as a boundary
  /// on the timeline instead of silently redrawing the past.
  rubricVersion     String?
  sourceDataVersion String?

  /// Deterministic scoring, computed in code BEFORE the model is called. The
  /// model interprets these; it is never asked to calculate or recall one.
  ///
  /// Two snapshots, never one scalar: threshold components cap at "met" and
  /// cannot be exceeded by doing more, differentiation has no ceiling. Blending
  /// them would let extra depth paper over an unmet prerequisite.
  thresholdSnapshotJson       String?
  differentiationSnapshotJson String?

  /// Zod enum: AHEAD | ON_PACE | BEHIND. Position against the modeled curve
  /// for this student's grade, not against other users.
  paceStatus String?

  /// Check-ins only. False means the deterministic pass found nothing material
  /// had changed, so no model was called and no quota was spent — a valid and
  /// expected outcome, not a failure.
  materialChange Boolean?

  /// The evaluation this one is measured against: the previous check-in for a
  /// check-in, the previous deep review for a deep review. They are different
  /// baselines on purpose.
  precedingEvaluationId String?
  precedingEvaluation   Evaluation?  @relation("EvaluationChain", fields: [precedingEvaluationId], references: [id], onDelete: SetNull)
  followingEvaluations  Evaluation[] @relation("EvaluationChain")

  commitmentsProposed Commitment[] @relation("CommitmentSource")
  commitmentsResolved Commitment[] @relation("CommitmentResolution")

  model         String? // AI model id that produced this (e.g. claude-opus-5)
  promptVersion String? // which /lib/prompts template version was used
  isSample      Boolean @default(false) // true = generated without an API key; NOT real AI output

  // Serialized JSON. inputSnapshotJson freezes the profile as it was at
  // evaluation time, so history stays faithful even after the profile is edited.
  inputSnapshotJson String?
  // resultJson is an EvaluationResult, Zod-validated before it is ever stored.
  resultJson        String?

  overallScore Int? // 0-100 headline, denormalized for the progress chart

  /// Everything the progress chart plots, denormalized out of the narrative.
  ///
  /// EXISTS SO THE CHART CAN OUTLIVE THE PROSE. The narrative is deleted on a
  /// retention schedule (see lib/evaluation/retention.ts), and buildProgress
  /// used to read the per-school fits and the narrative-coherence score
  /// straight out of resultJson — so expiring a narrative would have silently
  /// dropped that evaluation off a student's four-year chart. The point of the
  /// chart is watching a score move across the whole of secondary school, so
  /// losing the early points is losing the feature.
  ///
  /// Deliberately small and non-prose: scores, and the school names they belong
  /// to. It carries no assessment of anybody, which is what makes it safe to
  /// keep after the assessment itself is gone.
  chartPointJson String?

  error        String? // populated when status = failed
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  // What this run actually cost, straight from the API's usage block.
  //
  // Recorded because "it feels like it's costing more" is not something either
  // a user or a developer can act on. Cache reads and writes are separated
  // because they are priced differently — a write costs 2x base and a read
  // 0.1x, so a run that only ever WRITES the cache is more expensive than one
  // with no caching at all, and without these columns that is invisible.
  inputTokens      Int?
  outputTokens     Int?
  cacheWriteTokens Int?
  cacheReadTokens  Int?

  /// What this run cost, in cents, at the prices in lib/cost.ts.
  ///
  /// Stored rather than derived because prices change and a historical run
  /// should keep what it actually cost. Per-user cost drift across a four-year
  /// retention on a flat subscription is the main margin risk in this product,
  /// and it has to be observable from the first evaluation rather than
  /// reconstructed later from token counts and a guess at the price table.
  costCents Int?

  @@index([profileId])
  @@index([profileId, type, createdAt])
}

/// Something a student agreed to do, proposed by an evaluation.
///
/// This is the follow-through loop: a deep review proposes, the student
/// accepts, and check-ins ask about it at high frequency until it resolves.
///
/// Deliberately NOT the same table as PlannedItem, which is student-authored
/// and exists to feed conditional projections ("what would happen if I did
/// this?"). A Commitment is evaluation-authored and carries a resolution
/// lifecycle including abandonment, because what a student drops is signal a
/// later deep review is meant to read. The two overlap in spirit and are
/// distinct in what they are for; merging them would lose the abandonment
/// history on one side or the projection inputs on the other.
model Commitment {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// Set when this commitment began as a counselor's recommendation the student
  /// accepted. The direction matters: the counselor proposes, the student
  /// accepts, and only then does a row appear on the student's own side.
  fromRecommendations CounselorRecommendation[]

  sourceEvaluationId String?
  sourceEvaluation   Evaluation? @relation("CommitmentSource", fields: [sourceEvaluationId], references: [id], onDelete: SetNull)

  description String
  /// The rung this commitment is meant to reach — see lib/readiness/rungs.ts.
  targetRung  String?
  dueDate     DateTime?

  /// Zod enum: PROPOSED | ACCEPTED | IN_PROGRESS | COMPLETED | ABANDONED.
  /// ABANDONED is kept rather than deleted precisely because the pattern of
  /// what someone drops is the most honest thing in this table.
  status String @default("PROPOSED")

  resolvedAt             DateTime?
  resolvedInEvaluationId String?
  resolvedInEvaluation   Evaluation? @relation("CommitmentResolution", fields: [resolvedInEvaluationId], references: [id], onDelete: SetNull)

  developments Development[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, status])
}

/// Something the student says happened, in their own words.
///
/// The check-in already ASKS questions — "did you speak to the coach, and what
/// did they say?" — and until this existed there was nowhere to answer them.
/// That is the gap this fills: it is the reply channel for a loop the app had
/// already opened, not a journal.
///
/// Deliberately narrow, and it should stay narrow. This is not a diary, not a
/// feed, and never aggregated across students — the reasoning that shelved
/// activity discovery applies here with more force, because this is a minor
/// writing free text about their own life.
model Development {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// What happened. Short by design: a fortnight's news, not an essay.
  body String

  /// The commitment this answers, when it answers one. Nulled rather than
  /// cascaded if that commitment is ever removed — what the student said
  /// happened is still true even if the commitment it referred to is gone.
  commitmentId String?
  commitment   Commitment? @relation(fields: [commitmentId], references: [id], onDelete: SetNull)

  /// Set once a check-in has read it, so the next one does not re-litigate old
  /// news and a student is never told twice about the same thing.
  readByEvaluationId String?

  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
}

/// A completed grade year, compacted.
///
/// Exists for a cost reason that is structural rather than an optimisation. A
/// student is meant to stay for four years on a flat subscription, so a
/// senior's check-in must not cost several times a freshman's simply because
/// three more years of raw entries have accumulated behind them. Once a grade
/// year is done its entries are replaced in check-in context by this summary,
/// permanently.
///
/// Deep reviews still read the full history. That difference is exactly what
/// makes the tier boundary honest rather than a gate.
model ProfileDigest {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// The grade year this covers, e.g. 9, 10, 11.
  throughGrade Int
  /// Serialized, Zod-validated on read like every other structured value here.
  summaryJson  String

  generatedAt   DateTime @default(now())
  rubricVersion String?
  /// Which model compacted it. Digesting is a batch job on the cheap model.
  model         String?

  @@unique([profileId, throughGrade])
  @@index([profileId])
}

model TargetSchool {
  id             String   @id @default(cuid())
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name           String
  // FIRST-CLASS rubric driver: the evaluation branches on this per school.
  // ISO 3166-1 alpha-2 (US, GB, ...). lib/rubrics maps it to an admissions
  // rubric; the registry is extensible — add CA/AU later, no schema change.
  country        String
  course         String? // specific course/major at this school (matters most for UK)
  // No longer collected from the user — whether a school is a reach, match or
  // safety depends on the profile, so the evaluation determines it and reports
  // it per school. Kept nullable rather than dropped so values entered before
  // this change aren't destroyed.
  classification String?
  priority       Int?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([profileId])
}

/// Researched entry requirements for one course at one university.
///
/// Reference data, not user data: shared across every student targeting the
/// same course, gathered offline by a research agent against the brief in
/// lib/prompts/research/. Validated on ingest by
/// lib/validation/course-requirements.ts, which refuses anything whose facts
/// do not each carry a verbatim quote and a source URL.
///
/// Why it exists: the evaluator has no lookup. Its read on what a course
/// requires comes from model recollection, which is why `verifyThese` exists
/// at all. A sourced row lets the evaluation state a requirement AND show the
/// student where it came from — and, just as importantly, lets it keep saying
/// "check this" for everything not covered here.
model CourseRequirement {
  id         String @id @default(cuid())
  /// Normalized for matching (lowercased, punctuation and leading articles
  /// stripped). The display names are kept separately so the student sees what
  /// the university calls itself.
  matchKey   String @unique
  university String
  country    String
  course     String

  /// The admissions cycle the source page described.
  cycleYear        Int
  /// The researcher's own flag that the page was for an older cycle. Shown to
  /// the student, and it downgrades how the evaluation is told to treat it.
  stale            Boolean  @default(false)
  /// When the research ran. Requirements change annually, so a row ages into
  /// being untrustworthy and the UI says so rather than quietly aging.
  gatheredOn       DateTime
  primarySourceUrl String

  /// The requirements object, exactly as validated. Serialized JSON, checked
  /// against Zod on both write and read like every other structured value here.
  requirementsJson String

  /// Acceptance rate, when officially published. INTERNAL ONLY — it informs
  /// the selectivity tier and is never rendered and never handed to the model
  /// as a number. A headline rate is the most misread figure in admissions,
  /// and the app's ban on stating rates predates this table.
  acceptanceRatePercent   Float?
  acceptanceRateScope     String?
  acceptanceRateSourceUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country])
}

// ─────────────────────────────────────────────────────────────────────────────
// COUNSELOR EDITION
//
// A separate product surface for a professional running a caseload, not the
// student app with a switcher. The question it answers is "who needs me this
// week, and what do I say", which is an attention-allocation problem rather
// than an advice problem.
//
// Two things about these tables are load-bearing and easy to lose:
//
//   THE COUNSELOR IS A PROCESSOR, NOT AN OWNER. Nothing here grants ownership
//   of a student record. A CaseloadLink is a revocable grant of READ access,
//   held by the account that owns the profile, and every counselor read goes
//   through lib/counselor/access.ts — the same structural pattern as
//   lib/ownership.ts, for the same reason.
//
//   SCORING IS NOT DUPLICATED HERE. There is no readiness column on any of
//   these tables. A counselor sees exactly what scoreProfile() produces for the
//   same profile at the same rubricVersion, computed by the same code. A number
//   stored here would be a second source of truth and would eventually disagree
//   with the student's own screen.
// ─────────────────────────────────────────────────────────────────────────────

/// A professional account holding a caseload.
model CounselorAccount {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgName String?

  /// Zod enum: INDEPENDENT | SCHOOL_BASED | TUTORING_CENTER | TEST_PREP_TUTOR.
  ///
  /// SCHOOL_BASED is carried from the start although only INDEPENDENT ships:
  /// a school-employed counselor is inside FERPA's education-records regime and
  /// an independent one is not, which changes retention, disclosure and the
  /// parent's rights over the record. Retrofitting an access-control model onto
  /// live data is far worse than carrying an unused value.
  ///
  /// TEST_PREP_TUTOR is a DIFFERENT PRODUCT sharing this table, not a counselor
  /// with fewer permissions. A counselor's scarce resource is attention across a
  /// caseload, so they get triage; a test-prep tutor already knows who they are
  /// seeing on Tuesday and their scarce resource is JUSTIFICATION — what am I
  /// aiming at, and when do we stop. They share an account row because they
  /// share the consent and caseload machinery, and nothing else.
  type String @default("INDEPENDENT")

  /// Enforced server-side on every link creation, not merely displayed. Costs
  /// scale with caseload, so an unbounded caseload is an unbounded bill.
  caseloadLimit Int @default(40)

  links        CaseloadLink[]
  sessionPreps SessionPrep[]
  reads        CounselorReadLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One counselor's revocable access to one student.
model CaseloadLink {
  id                 String           @id @default(cuid())
  counselorAccountId String
  counselorAccount   CounselorAccount @relation(fields: [counselorAccountId], references: [id], onDelete: Cascade)

  /// The ACCOUNT that owns the student's record — who consents and who revokes.
  ///
  /// The brief specifies this field alone. In this codebase students do not log
  /// in: a User owns many Profile rows, and "a solo student is just an account
  /// with one profile". So a user id cannot name WHICH student when an account
  /// holds several, and studentProfileId below is a necessary addition rather
  /// than a liberty — without it the grant is ambiguous, and an ambiguous
  /// access grant is a leak waiting to happen.
  studentUserId String
  studentUser   User   @relation("CaseloadStudentUser", fields: [studentUserId], references: [id], onDelete: Cascade)

  /// The single student this link grants access to. Access is per STUDENT, never
  /// per account: a counselor tutoring one sibling gets no sight of the other.
  studentProfileId String
  studentProfile   Profile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  /// Zod enum: PENDING | ACTIVE | PAUSED | ENDED.
  status String @default("PENDING")

  /// Zod enum: COUNSELOR | STUDENT | GUARDIAN. Who initiated, which decides
  /// nothing about access and everything about how the invite is presented.
  invitedBy String

  /// DUAL CONSENT. Both must be non-null before any student data is readable,
  /// and that is checked in lib/counselor/access.ts rather than in a component.
  /// A counselor-initiated invite creates PENDING and shows nothing at all.
  guardianConsentAt DateTime?
  studentConsentAt  DateTime?

  /// Zod enum: FULL | ACADEMIC_ONLY | ACTIVITIES_ONLY | TEST_PREP_ONLY.
  ///
  /// Enforced in the Prisma SELECT, not by hiding a component. A subject tutor
  /// on ACADEMIC_ONLY has no business reading an activity portfolio, and the
  /// difference between "not rendered" and "not fetched" is the difference
  /// between a UI convention and a security property.
  ///
  /// TEST_PREP_ONLY is the NARROWEST scope in the product: score history, the
  /// target school list, and the thresholds derived from those two. No
  /// activities, no essays, no differentiation data, no counselor notes. A
  /// test-prep tutor is engaged for one number; everything else about this
  /// student is somebody else's business, and lib/testprep/access.ts is where
  /// that stops being a promise and becomes a WHERE clause.
  scope String @default("FULL")

  startedAt DateTime?
  endedAt   DateTime?

  signals           TriageSignal[]
  sessionPreps      SessionPrep[]
  recommendations   CounselorRecommendation[]
  reads             CounselorReadLog[]
  /// The test-prep edition's parent-facing output, when this link is a tutor's.
  progressArtifacts ProgressArtifact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One live link per counselor per student. A second row would double every
  /// triage signal and make revocation ambiguous.
  @@unique([counselorAccountId, studentProfileId])
  @@index([counselorAccountId, status])
  @@index([studentUserId, status])
}

/// A computed reason one student needs attention. NEVER a quality judgement.
model TriageSignal {
  id             String       @id @default(cuid())
  caseloadLinkId String
  caseloadLink   CaseloadLink @relation(fields: [caseloadLinkId], references: [id], onDelete: Cascade)

  /// Denormalized from the link so the caseload query can filter and sort
  /// without a join. The index below is the one the attention list rides on.
  counselorAccountId String

  /// Zod enum: STALE_PROFILE | THRESHOLD_NEWLY_BINDING | COMMITMENT_OVERDUE |
  /// TRAJECTORY_DROP | DEADLINE_APPROACHING | GOAL_TRAJECTORY_MISMATCH |
  /// RUNG_STALLED | NO_RECENT_SESSION.
  kind String

  /// 1-5, GRADE- AND TIME-AWARE rather than a constant per kind. The same unmet
  /// prerequisite is a plan for a 9th grader and a crisis for a 12th grader,
  /// because remaining time is what decides which it is.
  severity Int

  computedAt DateTime  @default(now())
  resolvedAt DateTime?

  /// The deterministic facts that produced this signal, so a counselor can vet
  /// it. Every model claim downstream traces back to one of these.
  basis Json

  createdAt DateTime @default(now())

  @@index([counselorAccountId, severity, resolvedAt])
  @@index([caseloadLinkId, resolvedAt])
}

/// Drafting material for a conversation the counselor will have.
///
/// NOT a report the student reads. The only per-student model cost in this
/// product, generated on demand for the handful triage surfaced rather than for
/// a whole caseload.
model SessionPrep {
  id             String       @id @default(cuid())
  caseloadLinkId String
  caseloadLink   CaseloadLink @relation(fields: [caseloadLinkId], references: [id], onDelete: Cascade)

  counselorAccountId String
  counselorAccount   CounselorAccount @relation(fields: [counselorAccountId], references: [id], onDelete: Cascade)

  generatedAt DateTime @default(now())

  /// Pinned like every generated artefact in this app. A prep is immutable and
  /// is never recomputed when the rubric moves on.
  ///
  /// promptVersion is here although the brief's field list omits it, for the
  /// same reason every other generated row in this codebase carries one: a prep
  /// read back in six months was produced by instructions that have since
  /// changed, and without the version there is no way to tell which.
  rubricVersion     String
  promptVersion     String?
  sourceDataVersion String?
  modelUsed         String?

  /// Which signals this prep was written against, so it can be read back beside
  /// the reasons it existed.
  triageSignalIds String[]

  /// Validated JSON, same discipline as every other structured value here.
  narrative Json?

  /// The counselor's own words. Feeds the NEXT prep's context — this is how the
  /// product learns what the model cannot see.
  counselorNotes String?

  /// Zod enum: PENDING | HELD | SKIPPED | RESCHEDULED.
  outcome String @default("PENDING")

  /// Recorded on every prep, including failed ones. A run that spent money
  /// always leaves a trace.
  inputTokens      Int?
  outputTokens     Int?
  cacheWriteTokens Int?
  cacheReadTokens  Int?
  costCents        Int?

  /// Set when generation failed, with what it burned.
  error String?

  recommendations CounselorRecommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([counselorAccountId, generatedAt])
  @@index([caseloadLinkId, generatedAt])
}

/// What the counselor actually chose to deliver, and what came of it.
///
/// The one dataset the student app cannot have. Surfaced as pattern observation
/// only: there is no effectiveness score, no cross-counselor benchmark, and no
/// join to admissions outcomes anywhere in this product.
model CounselorRecommendation {
  id            String       @id @default(cuid())
  sessionPrepId String?
  sessionPrep   SessionPrep? @relation(fields: [sessionPrepId], references: [id], onDelete: SetNull)

  caseloadLinkId String
  caseloadLink   CaseloadLink @relation(fields: [caseloadLinkId], references: [id], onDelete: Cascade)

  text String

  /// The computed fact behind it. Non-null by construction for model-suggested
  /// rows; a counselor-authored one carries their own reason.
  basis String

  /// Zod enum: MODEL_SUGGESTED | COUNSELOR_AUTHORED.
  source String

  /// Zod enum: PROPOSED | DELIVERED | DECLINED_BY_COUNSELOR | ACCEPTED_BY_STUDENT.
  ///
  /// DECLINED_BY_COUNSELOR is the interesting one and the reason this table
  /// exists: what a professional chose NOT to pass on is a judgement the model
  /// never made, and it is the only place that judgement is recorded.
  status String @default("PROPOSED")

  /// Set once the student accepts and it becomes a tracked commitment on their
  /// own side. The counselor proposes; the student accepts.
  linkedCommitmentId String?
  linkedCommitment   Commitment? @relation(fields: [linkedCommitmentId], references: [id], onDelete: SetNull)

  deliveredAt   DateTime?
  declineReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseloadLinkId, status])
  @@index([sessionPrepId])
}

/// Every counselor read of student data, visible to the student.
///
/// Not in the brief's table list, and required by it: "audit log every counselor
/// read of student data, retained and visible to the student". An audit log the
/// subject cannot see is a log for the operator's benefit, which is the opposite
/// of what this one is for.
model CounselorReadLog {
  id                 String           @id @default(cuid())
  counselorAccountId String
  counselorAccount   CounselorAccount @relation(fields: [counselorAccountId], references: [id], onDelete: Cascade)

  caseloadLinkId String
  caseloadLink   CaseloadLink @relation(fields: [caseloadLinkId], references: [id], onDelete: Cascade)

  /// Denormalized so the student's own view can query their reads directly,
  /// and so the row survives as a record of what was seen.
  studentProfileId String

  /// What was read, in the app's terms — "caseload.attention", "prep.generate",
  /// "student.detail". Coarse on purpose: a per-field log nobody reads is worse
  /// than a per-surface log a student can actually understand.
  surface String

  /// The scope in force at the time. A link narrowed later must not make an
  /// earlier broader read look narrower than it was.
  scope String

  readAt DateTime @default(now())

  @@index([studentProfileId, readAt])
  @@index([counselorAccountId, readAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// TEST-PREP TUTOR EDITION
//
// A third surface, and the narrowest. Deliberately NOT the counselor edition
// with fewer fields: a counselor allocates attention across a caseload and gets
// a triage engine, while a test-prep tutor already knows who they are seeing on
// Tuesday. Their scarce resource is JUSTIFICATION — what am I aiming at, and
// when do we stop — so what they get is a TARGET DERIVATION engine instead.
// There is no triage anywhere in this product and there must not be.
//
// Three things about these tables are load-bearing:
//
//   THE STOPPING SIGNAL IS THE PRODUCT. A threshold caps at MET (see
//   lib/readiness/threshold.ts, which has said so since it was written): once a
//   score clears the band for every school on the list, more points buy nothing.
//   Every other test-prep tool is silent here because saying so shortens the
//   engagement. StoppingSignal is a first-class table for the same reason the
//   audit log is: a thing the operator is tempted to suppress belongs in the
//   schema, not in a render condition.
//
//   NOTHING HERE PREDICTS A SCORE. There is no projected composite, no
//   trajectory, no target date. Practice-to-real variance is large, and a
//   predicted score shown to a parent becomes a promise the tutor has to answer
//   for. Observed history and current gap only — enforced by a phrasing check on
//   the one generated surface, the same way the student app bans probabilities.
//
//   THE MODEL COMPUTES NOTHING. Targets, bands, section allocation and stopping
//   are pure functions over these rows. The model writes one narrative per
//   student per month and is never asked to recall a percentile.
// ─────────────────────────────────────────────────────────────────────────────

/// A test that can be sat, and the shape of its score.
///
/// A row rather than an enum because the section structure IS data: the SAT has
/// two sections summing to a composite, the ACT has four averaging to one, the
/// UCAT has four cognitive subtests plus a band that is not numeric at all, and
/// an AP has a single 1-5. Hard-coding that shape would make adding a test a
/// migration, and would put the composite rule in code where it cannot be
/// inspected beside the scores it produced.
model TestType {
  id   String @id @default(cuid())
  /// SAT, ACT, UCAT, LNAT, AP_BIOLOGY, ... Stable, and referenced in prose.
  code String @unique
  /// Human label for the tutor's screen.
  name String

  /// Section names, per-section min/max, and anything the composite rule needs.
  /// Validated by testSectionSchemaSchema in lib/validation/testprep.ts.
  sectionSchema Json

  /// Zod enum: SUM | AVERAGE | HIGHEST_SECTION | NONE.
  ///
  /// NONE is real and not a placeholder — the LNAT's essay is not scored
  /// numerically at all, so a composite would be a number nobody reports.
  compositeRule String

  attempts ScoreAttempt[]
  policies SchoolTestPolicy[]
  targets  ScoreTarget[]
  stopping StoppingSignal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One sitting: a diagnostic, a practice test, or the real thing.
///
/// `kind` is not cosmetic. A DIAGNOSTIC anchors the starting point a progress
/// artifact reports from, an OFFICIAL is the only kind that can actually clear a
/// threshold, and a PRACTICE is noisy — the artifact is required to say so every
/// time it shows one.
model ScoreAttempt {
  id            String   @id @default(cuid())
  studentUserId String
  studentUser   User     @relation("TestPrepStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  testTypeId    String
  testType      TestType @relation(fields: [testTypeId], references: [id], onDelete: Cascade)

  /// Zod enum: DIAGNOSTIC | PRACTICE | OFFICIAL.
  kind    String
  takenAt DateTime

  /// { sectionName: score }. Shape validated against the TestType's schema.
  sectionScores Json
  /// Derived from sectionScores by the TestType's compositeRule, never entered
  /// by hand — a typed composite that disagrees with its sections is a number
  /// nobody can explain later. Null when the rule is NONE.
  composite     Int?

  /// Zod enum: STUDENT | TUTOR. Who typed it in.
  enteredBy  String
  /// Whether anybody checked it against a score report. A tutor reporting
  /// progress to a parent from unverified self-reported scores is the failure
  /// this flag exists to make visible.
  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The engine's read pattern: this student, this test, in time order.
  @@index([studentUserId, testTypeId, takenAt])
}

/// What one school does with one test, for one admissions cycle.
///
/// VERSIONED BY CYCLE, because these change annually and a target derived from
/// last year's policy is wrong in a way nobody notices. A test-blind school that
/// went back to requiring scores would otherwise stay silently excluded from a
/// student's binding target for a whole year.
model SchoolTestPolicy {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  testTypeId String
  testType   TestType @relation(fields: [testTypeId], references: [id], onDelete: Cascade)

  /// Zod enum: REQUIRED | OPTIONAL | BLIND.
  ///
  /// BLIND is the one that changes the arithmetic rather than shading it: a
  /// test-blind school cannot contribute a threshold at all, so it is excluded
  /// from the binding computation entirely rather than weighted down.
  policy String

  /// Whether the school combines best sections across sittings. This decides
  /// whether a single-section retake is rational, so it is stored per school and
  /// never assumed.
  superscores Boolean @default(false)
  /// Whether the student may choose which sittings to send.
  scoreChoice Boolean @default(false)

  /// Common Data Set quartiles for admitted students. Nullable because plenty of
  /// schools do not publish them, and a guessed quartile is worse than none.
  p25 Int?
  p50 Int?
  p75 Int?

  sourceDataVersion String
  /// The cycle this policy was published for, e.g. 2026.
  effectiveCycle    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One policy per school per test per cycle.
  @@unique([schoolId, testTypeId, effectiveCycle])
  @@index([schoolId, testTypeId])
  @@index([sourceDataVersion])
}

/// The score that actually clears this student's list, and who sets it.
///
/// `bindingSchoolId` is the point of this table. "1500" is a number a student
/// cannot act on; "1500, and it is Duke that asks for it" tells them what to do
/// about it — including the option of changing the list rather than the score.
model ScoreTarget {
  id            String   @id @default(cuid())
  studentUserId String
  studentUser   User     @relation("TestPrepStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  testTypeId    String
  testType      TestType @relation(fields: [testTypeId], references: [id], onDelete: Cascade)

  /// The composite that clears the realistic portion of the list. Null when no
  /// school on the list contributes a threshold — every one test-blind, or none
  /// publishing quartiles — which is a real answer and not a missing value.
  bindingComposite Int?
  /// Which school sets it. Null for the same reason.
  bindingSchoolId  String?
  bindingSchool    School? @relation(fields: [bindingSchoolId], references: [id], onDelete: SetNull)

  /// A BAND, not a point. CDS quartiles are a distribution of admitted students,
  /// not a cutoff, and reporting p75 as "the number to hit" invents a precision
  /// the source does not have.
  bandLow  Int?
  bandHigh Int?

  /// Named so the student can see WHY a school they listed is not in the maths.
  excludedBlindSchoolIds      String[]
  /// Test-optional schools that did not raise the target, and are shown as such.
  nonBindingOptionalSchoolIds String[]

  computedAt        DateTime @default(now())
  rubricVersion     String
  sourceDataVersion String

  allocations SectionAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One live target per student per test.
  @@unique([studentUserId, testTypeId])
}

/// Where the composite is cheapest to move, section by section.
model SectionAllocation {
  id            String      @id @default(cuid())
  scoreTargetId String
  scoreTarget   ScoreTarget @relation(fields: [scoreTargetId], references: [id], onDelete: Cascade)

  sectionName  String
  currentScore Int?
  /// Distance from current to the section maximum. Where the room is.
  headroom     Int

  /// A HEURISTIC, and labelled as one everywhere it is rendered.
  ///
  /// It models where headroom exists against what the composite rule does with
  /// it. It is NOT evidence about this student's learning rate, and presenting
  /// it as a measurement would be inventing a fact about a person from a fact
  /// about arithmetic.
  pointsPerUnitEffort Float

  recommendedFocus Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([scoreTargetId])
}

/// The moment more points stop buying anything.
///
/// A table, not a computed view, for one reason: it has to be ACKNOWLEDGED. A
/// signal the tutor can scroll past is a signal the business case says to scroll
/// past, so the acknowledgement is a column and the tutor view will not settle
/// until it is set.
model StoppingSignal {
  id            String   @id @default(cuid())
  studentUserId String
  studentUser   User     @relation("TestPrepStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  testTypeId    String
  testType      TestType @relation(fields: [testTypeId], references: [id], onDelete: Cascade)

  /// Zod enum: ALL_TARGETS_MET | MARGINAL_VALUE_ZERO | SUPERSCORE_COMPLETE |
  /// DIMINISHING_RETURNS | RETAKE_NOT_INDICATED.
  kind String

  firedAt               DateTime  @default(now())
  acknowledgedByTutorAt DateTime?
  /// Set when the facts stop holding — a target added, a policy changed. Kept
  /// rather than deleted so a parent asking "you told us to stop in March" can
  /// be answered.
  resolvedAt            DateTime?

  /// The computed facts behind it, so a tutor can check it before repeating it.
  basis Json

  createdAt DateTime @default(now())

  @@index([studentUserId, testTypeId, resolvedAt])
}

/// What the parent actually receives. The ONE model-generated surface here.
///
/// Reviewed by the tutor, then shared. The tutor may append their own context;
/// they may not edit the generated body, and they may not remove the stopping
/// notice — which is the whole reason the body is not editable.
model ProgressArtifact {
  id             String       @id @default(cuid())
  studentUserId  String
  studentUser    User         @relation("TestPrepStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  caseloadLinkId String
  caseloadLink   CaseloadLink @relation(fields: [caseloadLinkId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  generatedAt DateTime @default(now())

  /// Validated JSON. Null when generation failed — the row still records cost.
  narrative Json?

  /// The tutor's own words, appended to the artifact rather than mixed into it.
  tutorNote String?

  sharedWithGuardianAt DateTime?

  rubricVersion     String
  sourceDataVersion String?
  promptVersion     String?
  modelUsed         String?

  inputTokens      Int?
  outputTokens     Int?
  cacheWriteTokens Int?
  cacheReadTokens  Int?
  costCents        Int?

  /// Set when generation failed, with what it burned.
  error String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentUserId, periodEnd])
  @@index([caseloadLinkId, generatedAt])
}
